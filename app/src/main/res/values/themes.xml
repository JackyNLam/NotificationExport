<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      AppCompat (not MaterialComponents) so buttons keep the stock grey look the
      app has always had. NoActionBar because content is padded by window insets.
    -->
    <style name="Theme.NotificationExport" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>