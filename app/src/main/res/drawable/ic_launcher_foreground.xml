<?xml version="1.0" encoding="utf-8"?>
<!--
  Export glyph: an open tray with an arrow that rises and then turns to the
  upper right. Everything stays inside the 66dp adaptive safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- open-top tray -->
    <path
        android:fillColor="#00000000"
        android:pathData="M26,62 L26,76 Q26,82 32,82 L74,82 Q80,82 80,76 L80,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="8" />

    <!-- arrow: up, then bend to the upper right -->
    <path
        android:fillColor="#00000000"
        android:pathData="M48,72 L48,48 L63,34"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="9" />

    <!-- arrow head, pointing 45deg up-right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M72.2,24.8 L70.3,41.1 L56.1,28.5 Z" />
</vector>